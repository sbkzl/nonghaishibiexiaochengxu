.container { padding: 40rpx 30rpx 140rpx; }
.hero { text-align: center; padding: 40rpx 0 50rpx; }
.hero-icon { font-size: 100rpx; }
.hero-title { font-size: 40rpx; font-weight: bold; color: #2b7a4b; margin-top: 20rpx; }
.hero-sub { font-size: 26rpx; color: #888; margin-top: 12rpx; }

.recommend-card {
  background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
  border-radius: 20rpx; padding: 30rpx; margin-bottom: 30rpx;
}
.recommend-title { font-size: 30rpx; font-weight: bold; color: #e65100; margin-bottom: 20rpx; }
.rec-item { background: #fff; border-radius: 12rpx; padding: 20rpx; margin-bottom: 16rpx; }
.rec-name { font-size: 28rpx; font-weight: bold; color: #333; }
.rec-crop { font-size: 22rpx; color: #2b7a4b; margin-left: 10rpx; }
.rec-prevent { font-size: 24rpx; color: #666; margin-top: 10rpx; line-height: 1.6; }

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}
.grid-item {
  background: #fff; border-radius: 24rpx; padding: 40rpx 20rpx;
  text-align: center; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}
.grid-icon { font-size: 70rpx; }
.grid-title { font-size: 30rpx; font-weight: bold; color: #333; margin-top: 16rpx; }
.grid-desc { font-size: 22rpx; color: #999; margin-top: 10rpx; }
