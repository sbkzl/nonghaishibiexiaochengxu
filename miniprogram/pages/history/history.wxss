.container { padding: 20rpx 20rpx 140rpx; }
.header { font-size: 32rpx; font-weight: bold; color: #2b7a4b; padding: 20rpx 0; }
.history-item {
  background: #fff; border-radius: 16rpx; padding: 20rpx; margin-bottom: 20rpx;
  display: flex; align-items: center; box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.06);
}
.thumb { width: 120rpx; height: 120rpx; border-radius: 12rpx; margin-right: 20rpx; }
.info { flex: 1; }
.name { font-size: 30rpx; font-weight: bold; color: #333; }
.meta { font-size: 24rpx; color: #888; margin-top: 8rpx; }
.del-btn { font-size: 36rpx; padding: 10rpx; }
.empty { text-align: center; color: #999; padding: 100rpx 0; }
