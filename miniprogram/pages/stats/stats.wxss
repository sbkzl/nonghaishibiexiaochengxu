.container { padding: 20rpx 20rpx 140rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 30rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08); }
.title { font-size: 32rpx; font-weight: bold; color: #2b7a4b; margin-bottom: 24rpx; }
.pie { width: 500rpx; height: 500rpx; margin: 0 auto; }
.legend { margin-top: 30rpx; }
.legend-item { display: flex; align-items: center; margin: 12rpx 0; font-size: 26rpx; }
.dot { width: 20rpx; height: 20rpx; border-radius: 50%; margin-right: 12rpx; }
.bar-item { display: flex; align-items: center; margin: 20rpx 0; }
.bar-label { width: 200rpx; font-size: 26rpx; color: #333; }
.bar-track { flex: 1; height: 28rpx; background: #f0f0f0; border-radius: 14rpx; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 14rpx; }
.bar-count { width: 60rpx; text-align: right; font-size: 26rpx; color: #666; }
.overview { display: flex; justify-content: space-around; }
.ov-item { text-align: center; }
.ov-num { font-size: 48rpx; font-weight: bold; color: #2b7a4b; display: block; }
.ov-label { font-size: 24rpx; color: #888; }
